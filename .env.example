# Environment Variables for LinkedIn Content Studio

# App Auth Password (Required)
APP_PASSWORD="admin123"

# JWT Secret for cookie authentication
JWT_SECRET="linkedin-studio-secret-key-change-in-production-123456"

# Database Connection (SQLite for local dev, Vercel Postgres URL for production)
DATABASE_URL="file:./dev.db"

# Optional initial Gemini API Key (Can also be set in Settings UI)
GEMINI_API_KEY=""


