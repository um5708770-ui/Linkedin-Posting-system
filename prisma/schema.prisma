generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id              String    @id @default(cuid())
  status          String    @default("idea") // idea | draft | scheduled | ready | published
  ideaTitle       String?
  ideaDescription String?
  postText        String?
  seoTags         String?   // JSON string array
  imagePrompt     String?
  imageUrl        String?   // Base64 data URL or external image URL
  imageOptions    String?   // JSON string array of 4 generated candidate URLs/data
  scheduledFor    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Settings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



